# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# Point this at your MongoDB. Options:
#   - MongoDB Atlas (free cloud): paste your SRV string, e.g.
#       mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/primetrade
#   - Locally installed MongoDB:  mongodb://localhost:27017/primetrade
MONGODB_URI=mongodb://localhost:27017/primetrade

# Zero-install option: set to true to run an ephemeral in-memory MongoDB
# (or just use `npm run dev:memory`). Data is NOT persisted across restarts.
# When true, MONGODB_URI above is ignored.
USE_IN_MEMORY_DB=false

# ---- JWT ----
# Generate strong secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Rate limiting (per IP) ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# ---- Seed admin (used by `npm run seed`) ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@primetrade.ai
SEED_ADMIN_PASSWORD=Admin@12345

{
  "name": "primetrade-backend",
  "version": "1.0.0",
  "description": "Scalable REST API with JWT auth, role-based access, and Task CRUD (Primetrade.ai backend assignment)",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:memory": "cross-env USE_IN_MEMORY_DB=true nodemon src/server.js",
    "seed": "node src/seed.js",
    "smoke": "node verify-api.mjs",
    "test": "node --test"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "rest-api",
    "rbac"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.4"
  }
}
